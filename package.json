{
  "name": "dsh-pptx-studio",
  "version": "0.2.2",
  "description": "Design-first PowerPoint generation for DeepSeek Harness: guided intake, consistent AI imagery, and editable slides",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pptx",
    "powerpoint",
    "slides"
  ],
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "pnpm run build && pnpm pack --pack-destination dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.17.1",
    "jpeg-js": "~0.4.4",
    "jszip": "^3.10.2",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
